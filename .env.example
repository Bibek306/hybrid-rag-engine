# Use official lightweight Python 3.11 Debian slim base image
FROM python:3.11-slim

# Prevent Python from writing bytecode (.pyc) and ensure unbuffered stdout/stderr logging
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/app/cache/huggingface \
    PORT=7860

WORKDIR /app

# Install minimal Linux build utilities for FAISS and C-bindings
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Pre-download and cache model weights into image layer to eliminate boot-time latency
RUN python -c "
from sentence_transformers import SentenceTransformer, CrossEncoder
print('Pre-caching dense model...')
SentenceTransformer('BAAI/bge-small-en-v1.5')
print('Pre-caching reranker model...')
CrossEncoder('BAAI/bge-reranker-base')
"

# Copy application source code, pre-computed indices, and documents
COPY ./app ./app
COPY ./storage ./storage
COPY ./data ./data

# Create and switch to a non-root user (required by Hugging Face Spaces security sandbox)
RUN useradd -m -u 1000 user && \
    chown -R user:user /app
USER user

# Hugging Face Spaces listens on port 7860 by default
EXPOSE 7860

# Container healthcheck targeting the FastAPI /health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:7860/health || exit 1

# Launch the FastAPI application using Uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860", "--workers", "1"]